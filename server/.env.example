# Postgres connection (docker-compose in the repo root starts one with these credentials)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/calorie_tracker"

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Free key from https://fdc.nal.usda.gov/api-key-signup
# DEMO_KEY works for trying it out but is heavily rate-limited.
USDA_API_KEY="DEMO_KEY"

PORT=4000
CLIENT_ORIGIN="http://localhost:5173"
